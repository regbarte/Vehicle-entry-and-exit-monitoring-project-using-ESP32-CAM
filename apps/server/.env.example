# MongoDB Atlas: Database > Connect > Drivers, copy the mongodb+srv string.
# Add your IP under Network Access, and use a database user with readWrite.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=guardhouse

# Boom barrier Arduino. Leave BARRIER_PORT out to use a fake barrier.
# See apps/firmware/README.md for finding the port and the subdivision id.
# BARRIER_PORT=/dev/cu.usbmodem11101
# BARRIER_SUBDIVISION_ID=6720f1a2b3c4d5e6f7a8b9c0
