{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^gen:types"]
    },
    "build": {
      "dependsOn": ["^build", "^gen:types"],
      "outputs": ["dist/**"]
    },
    "gen:types": {
      "dependsOn": ["^openapi"],
      "outputs": ["src/**"]
    },
    "openapi": {
      "outputs": ["openapi.json"]
    },
    "test": {},
    "lint": {}
  }
}
